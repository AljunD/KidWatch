{
  "info": {
    "name": "KidWatch Guardian API",
    "description": "Postman collection for Guardian-facing mobile API endpoints (view-only + summary generation).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Login",
          "request": {
            "method": "POST",
            "header": [],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"guardian@example.com\",\n  \"password\": \"secret\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/guardian/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "guardian", "login"]
            }
          }
        },
        {
          "name": "Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/guardian/logout",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "guardian", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "Guardian Profile",
      "item": [
        {
          "name": "View Profile",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/guardian/profile",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "guardian", "profile"]
            }
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Juan\",\n  \"last_name\": \"Dela Cruz\",\n  \"contact_number\": \"09123456789\",\n  \"address\": \"Quezon City\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/guardian/profile",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "guardian", "profile"]
            }
          }
        }
      ]
    },
    {
      "name": "Students",
      "item": [
        {
          "name": "List Students",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/guardian/students",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "guardian", "students"]
            }
          }
        },
        {
          "name": "Show Student",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/guardian/students/:student_id",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "guardian", "students", ":student_id"]
            }
          }
        }
      ]
    },
    {
      "name": "Progress Records",
      "item": [
        {
          "name": "List Progress Records",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/guardian/students/:student_id/progress?week=1",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "guardian", "students", ":student_id", "progress"],
              "query": [{ "key": "week", "value": "1" }]
            }
          }
        }
      ]
    },
    {
      "name": "Weekly Summaries",
      "item": [
        {
          "name": "List Summaries",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/guardian/students/:student_id/summaries",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "guardian", "students", ":student_id", "summaries"]
            }
          }
        },
        {
          "name": "Show Summary",
          "request": {
            "method": "GET",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/guardian/students/:student_id/summaries/:week",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "guardian", "students", ":student_id", "summaries", ":week"]
            }
          }
        },
        {
          "name": "Generate Summary",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Authorization", "value": "Bearer {{token}}", "type": "text" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/guardian/students/:student_id/summaries/:week/generate",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "guardian", "students", ":student_id", "summaries", ":week", "generate"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "token", "value": "" }
  ]
}
