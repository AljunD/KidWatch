{
  "info": {
    "name": "KidWatch Guardian API",
    "description": "Postman collection for Guardian API endpoints (v1.7).",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "Authentication",
      "item": [
        {
          "name": "Guardian Login",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"aljundalman@gmail.com\",\n  \"password\": \"Password123@\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/guardian/login",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "guardian", "login"]
            }
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "let jsonData = pm.response.json();",
                  "if (jsonData.success && jsonData.token) {",
                  "    pm.environment.set(\"token\", jsonData.token);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
        {
          "name": "Guardian Logout",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/guardian/logout",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "guardian", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "Guardian Profile",
      "item": [
        {
          "name": "View Profile",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/guardian/profile",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "guardian", "profile"]
            }
          }
        },
        {
          "name": "Update Profile",
          "request": {
            "method": "PUT",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"first_name\": \"Aljun\",\n  \"middle_name\": \"\",\n  \"last_name\": \"Dalman\",\n  \"relationship_to_child\": \"Father\",\n  \"contact_number\": \"09171234567\",\n  \"address\": \"Quezon City, Metro Manila\"\n}"
            },
            "url": {
              "raw": "{{base_url}}/api/v1/guardian/profile",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "guardian", "profile"]
            }
          }
        }
      ]
    },
    {
      "name": "Students",
      "item": [
        {
          "name": "List Students",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/guardian/students",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "guardian", "students"]
            }
          }
        },
        {
          "name": "Show Student",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/guardian/students/:student",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "guardian", "students", ":student"]
            }
          }
        }
      ]
    },
    {
      "name": "Progress Records",
      "item": [
        {
          "name": "List Progress Records",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/guardian/students/:student/progress",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "guardian", "students", ":student", "progress"]
            }
          }
        }
      ]
    },
    {
      "name": "Weekly Summaries",
      "item": [
        {
          "name": "List Summaries",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/guardian/students/:student/summaries",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "guardian", "students", ":student", "summaries"]
            }
          }
        },
        {
          "name": "Show Summary",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/guardian/students/:student/summaries/:week",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "guardian", "students", ":student", "summaries", ":week"]
            }
          }
        },
        {
          "name": "Generate Summary",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json", "type": "text" }
            ],
            "url": {
              "raw": "{{base_url}}/api/v1/guardian/students/:student/summaries/:week/generate",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "guardian", "students", ":student", "summaries", ":week", "generate"]
            }
          }
        }
      ]
    }
  ],
  "variable": [
    { "key": "base_url", "value": "http://localhost:8000" },
    { "key": "token", "value": "" }
  ],
  "event": [
    {
      "listen": "prerequest",
      "script": {
        "exec": [
          "// Automatically add Authorization header if token exists",
          "let token = pm.environment.get(\"token\") || pm.globals.get(\"token\");",
          "if (token) {",
          "    pm.request.headers.add({",
          "        key: \"Authorization\",",
          "        value: \"Bearer \" + token",
          "    });",
          "}"
        ],
        "type": "text/javascript"
      }
    }
  ]
}
